{
  "expo": {
    "name": "DoorWay-App",
    "slug": "doorway-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "doorway",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2540"
    },
    "android": {
      "package": "com.unipaz.doorwayapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2540"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "DoorWay-App necesita acceso a tu galería para adjuntar comprobantes de pago.",
          "cameraPermission": "DoorWay-App necesita acceso a tu cámara para fotografiar el recibo o soporte bancario."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c266b1bf-5d33-434a-ac7c-cce9f7d8fdf1"
      }
    },
    "owner": "wilfranb"
  }
}
